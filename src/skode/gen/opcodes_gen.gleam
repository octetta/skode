pub fn complete(prefix: String) -> List(String) {
  case prefix {
    "" -> []
    _ -> {
      let exact =
        list.filter(all_commands, fn(c) { string.starts_with(c, prefix) })
      case exact {
        [_, ..] -> exact
        [] -> {
          let lower = string.lowercase(prefix)
          list.filter(all_commands, fn(c) {
            string.starts_with(string.lowercase(c), lower)
          })
        }
      }
    }
  }
}
