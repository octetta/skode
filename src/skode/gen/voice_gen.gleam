pub fn is_configured(voice: Voice) -> Bool {
  voice != default(voice.id)
}

pub type VoiceLinkKind {
  LinkHardSync
  LinkFreqMod
  LinkAmpMod
  LinkPanMod
  LinkPhaseMod
  LinkRingMod
  LinkMidiFollow
  LinkVeloFollow
}

pub type VoiceLink {
  VoiceLink(from_voice: Int, to_voice: Int, kind: VoiceLinkKind)
}

pub fn get_links(voice: Voice) -> List(VoiceLink) {
  let links = []
  let links = case voice.cz_mod_osc >= 0 && voice.cz_mod_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.cz_mod_osc, LinkPhaseMod), ..links]
    False -> links
  }
  let links = case voice.freq_mod_osc >= 0 && voice.freq_mod_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.freq_mod_osc, LinkFreqMod), ..links]
    False -> links
  }
  let links = case voice.amp_mod_osc >= 0 && voice.amp_mod_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.amp_mod_osc, LinkAmpMod), ..links]
    False -> links
  }
  let links = case voice.pan_mod_osc >= 0 && voice.pan_mod_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.pan_mod_osc, LinkPanMod), ..links]
    False -> links
  }
  let links = case voice.ring_osc >= 0 && voice.ring_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.ring_osc, LinkRingMod), ..links]
    False -> links
  }
  let links = case voice.pwm_mod_osc >= 0 && voice.pwm_mod_osc != voice.id {
    True -> [VoiceLink(voice.id, voice.pwm_mod_osc, LinkHardSync), ..links]
    False -> links
  }
  let links =
    list.fold(voice.link_sync, links, fn(acc, raw) {
      let tgt = float.round(raw)
      case tgt >= 0 && tgt != voice.id {
        True -> [VoiceLink(voice.id, tgt, LinkHardSync), ..acc]
        False -> acc
      }
    })
  let links =
    list.fold(voice.link_midi, links, fn(acc, raw) {
      let tgt = float.round(raw)
      case tgt >= 0 && tgt != voice.id {
        True -> [VoiceLink(voice.id, tgt, LinkMidiFollow), ..acc]
        False -> acc
      }
    })
  let links =
    list.fold(voice.link_velo, links, fn(acc, raw) {
      let tgt = float.round(raw)
      case tgt >= 0 && tgt != voice.id {
        True -> [VoiceLink(voice.id, tgt, LinkVeloFollow), ..acc]
        False -> acc
      }
    })
  list.reverse(links)
}
